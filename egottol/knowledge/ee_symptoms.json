{
  "version": 1,
  "entries": [
    {"id": "led-burn", "symptoms": ["led burned", "led too bright", "led current"], "combination": "Resistor + LED (series)", "behavior": "Limits current to safe level", "use": "Every LED indicator", "doc": "docs/ee/symptom-solver.md"},
    {"id": "flyback", "symptoms": ["relay kills transistor", "solenoid spike", "motor destroys mosfet", "inductive kick", "flyback"], "combination": "Diode || inductor/relay/solenoid/motor (reversed)", "behavior": "Recirculates coil current when switch opens", "use": "Mandatory freewheel path", "doc": "docs/ee/golden-rules.md"},
    {"id": "decouple", "symptoms": ["power supply noise", "rail ringing", "ic brownout", "decoupling"], "combination": "Capacitor || supply rail (0.1uF + bulk)", "behavior": "Shunts HF; bulk holds longer di/dt", "use": "Every digital/analog IC", "doc": "docs/ee/pcb-design.md"},
    {"id": "ac-couple", "symptoms": ["dc offset audio", "mic dc bias", "block dc"], "combination": "Capacitor in series with signal", "behavior": "High-pass; blocks DC", "use": "Audio coupling, AC into BJT base", "doc": "docs/ee/combinations.md"},
    {"id": "rc-lpf", "symptoms": ["high frequency noise", "anti alias", "low pass"], "combination": "R + C low-pass (series R / shunt C)", "behavior": "Passes DC/low freq; attenuates HF", "use": "ADC anti-alias, sensor filter", "doc": "docs/ee/combinations.md"},
    {"id": "rc-hpf", "symptoms": ["tweeter bass", "high pass filter", "block bass"], "combination": "R + C series high-pass", "behavior": "Blocks DC/low; passes HF", "use": "Audio crossovers", "doc": "docs/ee/combinations.md"},
    {"id": "lc-tank", "symptoms": ["radio tuner", "one frequency", "tank circuit", "resonance"], "combination": "L || C parallel tank", "behavior": "Highest Z at f0", "use": "Tuners, band-stop branches", "doc": "docs/ee/combinations.md"},
    {"id": "boost", "symptoms": ["step up voltage", "5v to 12v", "boost converter", "camera flash hv"], "combination": "Inductor + transistor series + diode + Cout", "behavior": "Stores energy; flyback raises Vout", "use": "Boost converters", "doc": "docs/ee/transistors.md"},
    {"id": "buck", "symptoms": ["step down efficient", "12v to 5v", "buck converter", "cpu vrm"], "combination": "MOSFET + L series + C || load + freewheel diode/FET", "behavior": "PWM averages voltage; L smooths I", "use": "Phone/CPU regulators", "doc": "docs/ee/transistors.md"},
    {"id": "emitter-bypass", "symptoms": ["bjt too quiet", "need more gain", "emitter bypass"], "combination": "Capacitor || emitter resistor", "behavior": "AC shorts Re → max Av", "use": "Audio preamps", "doc": "docs/ee/transistors.md"},
    {"id": "speedup-cap", "symptoms": ["bjt slow switching", "bjt hot while switching"], "combination": "Capacitor || base resistor", "behavior": "Speed-up charge dump", "use": "Fast BJT switches", "doc": "docs/ee/transistors.md"},
    {"id": "gate-pulldown", "symptoms": ["mosfet stays on", "floating gate", "gate leak"], "combination": "R pull-down G–S (+ optional C||GS)", "behavior": "Holds gate off; absorbs leak", "use": "Logic-level FET drives", "doc": "docs/ee/transistors.md"},
    {"id": "zener-gate", "symptoms": ["gate overvoltage", "24v into 20v gate"], "combination": "Zener || Gate-Source", "behavior": "Clamps Vgs", "use": "Industrial gate drive", "doc": "docs/ee/transistors.md"},
    {"id": "crystal-start", "symptoms": ["crystal not oscillating", "mcu no clock"], "combination": "Resistor || crystal (~1M) + load caps", "behavior": "Biases amp into linear region; sets f", "use": "MCU clocks", "doc": "docs/ee/symptom-solver.md"},
    {"id": "two-clocks", "symptoms": ["two crystals", "16mhz and 32khz", "select clock"], "combination": "Oscillator1 + Oscillator2 + MUX", "behavior": "Digital select; crystals never paralleled", "use": "Run vs sleep clocks", "doc": "docs/ee/series-parallel.md"},
    {"id": "mux-adc", "symptoms": ["one adc many sensors", "not enough analog pins"], "combination": "MUX + sample/hold capacitor", "behavior": "Time-multiplex inputs", "use": "Multi-sensor MCU", "doc": "docs/ee/symptom-solver.md"},
    {"id": "relay-driver", "symptoms": ["3.3v control 12v", "mcu drive relay"], "combination": "Transistor + relay coil series + flyback diode", "behavior": "Low-side switch + kickback clamp", "use": "Home automation / PLC outs", "doc": "docs/ee/motors.md"},
    {"id": "hbridge", "symptoms": ["motor reverse", "bidirectional motor", "h-bridge"], "combination": "Four transistors + motor", "behavior": "Reverses polarity across motor", "use": "Robot drives", "doc": "docs/ee/motors.md"},
    {"id": "motor-emi", "symptoms": ["motor radio noise", "brush noise"], "combination": "Ceramic C || motor terminals", "behavior": "Snubs commutation spikes", "use": "Brushed DC", "doc": "docs/ee/motors.md"},
    {"id": "darlington", "symptoms": ["tiny base current", "need high beta", "touch switch"], "combination": "Darlington BJT pair", "behavior": "β multiplies", "use": "High-gain switches", "doc": "docs/ee/transistors.md"},
    {"id": "cascode", "symptoms": ["high voltage switch", "miller capacitance rf"], "combination": "Cascode (FET/BJT stacked)", "behavior": "Bottom switches; top holds voltage", "use": "RF / HV drives", "doc": "docs/ee/transistors.md"},
    {"id": "voltage-doubler", "symptoms": ["double voltage", "charge pump", "no transformer hv"], "combination": "C + Diode + C multiplier", "behavior": "Steers charge into series stack", "use": "Flash / charge pumps", "doc": "docs/ee/combinations.md"},
    {"id": "diode-drop", "symptoms": ["drop 0.7v", "cheap regulator diodes"], "combination": "Diodes in series on supply", "behavior": "≈0.7V per silicon diode", "use": "Crude level drop", "doc": "docs/ee/series-parallel.md"},
    {"id": "floorplan", "symptoms": ["where to place parts", "pcb floorplan", "dirty clean zone"], "combination": "Dirty / Digital / Clean floorplan", "behavior": "Partition by noise before routing", "use": "All boards", "doc": "docs/ee/pcb-design.md"},
    {"id": "pdn", "symptoms": ["voltage droop", "pdn impedance", "power integrity"], "combination": "Bulk + mid + HF capacitor hierarchy", "behavior": "Keep Z below ΔV/ΔI across frequency", "use": "Digital SoC boards", "doc": "docs/ee/pcb-design.md"},
    {"id": "snubber", "symptoms": ["switching ring", "mosfet ringing", "rc snubber"], "combination": "R+C series across switch / diode", "behavior": "Damps LC ringing", "use": "SMPS / relay drivers", "doc": "docs/ee/golden-rules.md"},
    {"id": "current-sense", "symptoms": ["measure current", "shunt resistor", "overcurrent"], "combination": "Low-R shunt + differential amp", "behavior": "I → V drop", "use": "Motor / supply monitoring", "doc": "docs/ee/motors.md"},
    {"id": "bleeder", "symptoms": ["cap stays charged", "shock after power off", "bleeder"], "combination": "Resistor || bulk capacitor", "behavior": "Discharges stored energy", "use": "HV / large electrolytics", "doc": "docs/ee/golden-rules.md"},
    {"id": "star-gnd", "symptoms": ["ground loop hum", "shared return noise"], "combination": "Star / single-point analog ground", "behavior": "Keeps return currents from mixing", "use": "Mixed-signal boards", "doc": "docs/ee/pcb-design.md"},
    {"id": "tvs", "symptoms": ["esd kill", "transient surge", "input protection"], "combination": "TVS / clamp diode to rail", "behavior": "Crowbars overvoltage spikes", "use": "Connector / antenna inputs", "doc": "docs/ee/symptom-solver.md"}
  ]
}
